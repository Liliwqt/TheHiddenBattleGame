<Window x:Class="FinalProject_TheHiddenBattleGame_Pamaybay_Hofer_Pillado.PlayerSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player Setup" Height="600" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Player 1" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Name:" Margin="0,0,0,5"/>
            <TextBox x:Name="Player1NameTxt" Margin="0,0,0,10"/>
            <TextBlock Text="Gender:" Margin="0,0,0,5"/>
            <ComboBox x:Name="Player1GenderCmb" SelectionChanged="Player1GenderCmb_SelectionChanged" Margin="0,0,0,10">
                <ComboBoxItem Content="Male"/>
                <ComboBoxItem Content="Female"/>
            </ComboBox>
            <TextBlock Text="Avatar:" Margin="0,0,0,5"/>
            <ListBox x:Name="Player1AvatarList" Height="200" Margin="0,0,0,10"/>
            <TextBlock Text="Chant:" Margin="0,0,0,5"/>
            <TextBox x:Name="Player1ChantTxt" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Player 2" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Name:" Margin="0,0,0,5"/>
            <TextBox x:Name="Player2NameTxt" Margin="0,0,0,10"/>
            <TextBlock Text="Gender:" Margin="0,0,0,5"/>
            <ComboBox x:Name="Player2GenderCmb" SelectionChanged="Player2GenderCmb_SelectionChanged" Margin="0,0,0,10">
                <ComboBoxItem Content="Male"/>
                <ComboBoxItem Content="Female"/>
            </ComboBox>
            <TextBlock Text="Avatar:" Margin="0,0,0,5"/>
            <ListBox x:Name="Player2AvatarList" Height="200" Margin="0,0,0,10"/>
            <TextBlock Text="Chant:" Margin="0,0,0,5"/>
            <TextBox x:Name="Player2ChantTxt" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Back" Width="100" Margin="0,0,20,0" Click="BackBtn_Click"/>
            <Button Content="Start Battle" Width="120" Click="StartBattleBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>