<Window x:Class="FinalProject_TheHiddenBattleGame_Pamaybay_Hofer_Pillado.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Hidden Battle Game" Height="700" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock x:Name="PhaseText" Text="STRATEGY PHASE" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="StageRoundText" Text="Stage 1 - Round 1" FontSize="14" Margin="0,0,0,10"/>
            <TextBlock x:Name="TimerText" Text="--" FontSize="14" Foreground="Orange" Margin="0,0,0,10"/>
            <TextBlock x:Name="BattlefieldTitle" Text="Player 1's Turn" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Player1Border" Grid.Column="0" Margin="10" Padding="10" BorderBrush="Transparent" BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="Player1NameTxt" Text="Player 1" FontWeight="Bold"/>
                    <TextBlock x:Name="Player1GenderTxt" Text="M"/>
                    <Border x:Name="Player1AvatarBorder" Width="120" Height="120" Margin="10"/>
                    <StackPanel x:Name="Player1BarsPanel" Margin="0,10,0,0">
                        <TextBlock Text="Life" FontSize="12"/>
                        <ProgressBar x:Name="Player1LifeBar" Height="20" Maximum="100" Value="100"/>
                        <TextBlock Text="Power" FontSize="12" Margin="0,5,0,0"/>
                        <ProgressBar x:Name="Player1PowerBar" Height="20" Maximum="10" Value="0"/>
                    </StackPanel>
                    <ListBox x:Name="Player1ObjectsList" Height="150" Margin="0,10,0,0"/>
                    <Button x:Name="Player1FinishBtn" Content="Finish" Margin="0,10,0,0" Click="FinishBtn_Click" Tag="1"/>
                    <Button x:Name="Player1PowerUpBtn" Content="Power-Up" Margin="0,5,0,0" Click="PowerUpBtn_Click" Tag="1"/>
                    <TextBlock x:Name="Player1PointsTxt" Text="0" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="10">
                <Grid x:Name="BattlefieldGrid"/>
            </Border>

            <Border x:Name="Player2Border" Grid.Column="2" Margin="10" Padding="10" BorderBrush="Transparent" BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="Player2NameTxt" Text="Player 2" FontWeight="Bold"/>
                    <TextBlock x:Name="Player2GenderTxt" Text="M"/>
                    <Border x:Name="Player2AvatarBorder" Width="120" Height="120" Margin="10"/>
                    <StackPanel x:Name="Player2BarsPanel" Margin="0,10,0,0">
                        <TextBlock Text="Life" FontSize="12"/>
                        <ProgressBar x:Name="Player2LifeBar" Height="20" Maximum="100" Value="100"/>
                        <TextBlock Text="Power" FontSize="12" Margin="0,5,0,0"/>
                        <ProgressBar x:Name="Player2PowerBar" Height="20" Maximum="10" Value="0"/>
                    </StackPanel>
                    <ListBox x:Name="Player2ObjectsList" Height="150" Margin="0,10,0,0"/>
                    <Button x:Name="Player2FinishBtn" Content="Finish" Margin="0,10,0,0" Click="FinishBtn_Click" Tag="2"/>
                    <Button x:Name="Player2PowerUpBtn" Content="Power-Up" Margin="0,5,0,0" Click="PowerUpBtn_Click" Tag="2"/>
                    <TextBlock x:Name="Player2PointsTxt" Text="0" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>