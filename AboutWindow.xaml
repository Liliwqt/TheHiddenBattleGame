<Window x:Class="FinalProject_TheHiddenBattleGame_Pamaybay_Hofer_Pillado.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="350" Width="400">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="The Hidden Battle Game" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="A 2-player WPF battleship-style strategy game" Margin="0,0,0,10"/>
            <TextBlock Text="Authors: Pamaybay, Hofer, Pillado" Margin="0,0,0,10"/>
            <TextBlock Text="School Final Project - 2024" Margin="0,0,0,10"/>
            <TextBlock Text=".NET 10 • WPF • C#" Margin="0,0,0,20"/>
            <Button Content="Close" Width="100" HorizontalAlignment="Right" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>