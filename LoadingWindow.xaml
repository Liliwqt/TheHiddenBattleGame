<Window x:Class="FinalProject_TheHiddenBattleGame_Pamaybay_Hofer_Pillado.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="StageText" Text="STAGE 1" FontSize="24" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="RoundText" Text="Round 1" FontSize="18" Margin="0,0,0,20"/>
            <TextBlock x:Name="MessageText" Text="Strategy Phase - Deploy your fleet!" FontSize="16" Margin="0,0,0,20"/>
            <TextBlock x:Name="CountdownText" Text="3" FontSize="32" FontWeight="Bold" Foreground="Blue"/>
        </StackPanel>
    </Grid>
</Window>