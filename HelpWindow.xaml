<Window x:Class="FinalProject_TheHiddenBattleGame_Pamaybay_Hofer_Pillado.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help" Height="400" Width="500">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="How to Play" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                1. Strategy Phase: Place your ships on the 20×20 grid.
                2. Battle Phase: Take turns attacking enemy cells.
                3. Destroy all enemy ships to win the round.
                4. Win 2 rounds to win the stage.
                5. Win 12 stages to win the game.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                Power-ups: Radar Scan, Double Shot, Triple Shot, Missile Barrage, Air Strike, Torpedo, Lucky Shot.
            </TextBlock>
            <Button Content="Close" Width="100" HorizontalAlignment="Right" Click="CloseBtn_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>